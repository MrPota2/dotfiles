[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[credential]
	helper = manager

[push]
	autoSetupRemote = true

[pull]
	rebase = true

[user]
	name = Adrian Milvang
	email = adrian.milvang@gmail.com
	signingkey = ~/.ssh/id_ed25519.pub
[init]
	defaultBranch = main

[core]
	editor = nvim
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[pager]
	log = false
[diff]
	tool = vimdiff
	algorithm = minimal
